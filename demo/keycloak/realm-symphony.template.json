{
  "realm": "symphony",
  "displayName": "Symphony (démo)",
  "enabled": true,
  "sslRequired": "none",
  "groups": [
    { "name": "symphony-admins" },
    { "name": "symphony-leads" },
    { "name": "symphony-developers" },
    { "name": "symphony-viewers" },
    {
      "name": "teams",
      "subGroups": [
        { "name": "team-identity" },
        { "name": "team-payments" },
        { "name": "team-platform" },
        { "name": "team-product" }
      ]
    }
  ],
  "users": [
    {
      "username": "alice", "email": "alice@demo.symphony", "firstName": "Alice", "lastName": "Admin",
      "enabled": true, "emailVerified": true, "groups": ["/symphony-admins", "/teams/team-platform"],
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "username": "lina", "email": "lina@demo.symphony", "firstName": "Lina", "lastName": "Lead",
      "enabled": true, "emailVerified": true, "groups": ["/symphony-leads", "/teams/team-payments"],
      "credentials": [{ "type": "password", "value": "lina", "temporary": false }]
    },
    {
      "username": "bob", "email": "bob@demo.symphony", "firstName": "Bob", "lastName": "Developer",
      "enabled": true, "emailVerified": true, "groups": ["/symphony-developers", "/teams/team-payments"],
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    },
    {
      "username": "carol", "email": "carol@demo.symphony", "firstName": "Carol", "lastName": "Viewer",
      "enabled": true, "emailVerified": true, "groups": ["/symphony-viewers", "/teams/team-product"],
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }]
    },
    {
      "username": "dave", "email": "dave@demo.symphony", "firstName": "Dave", "lastName": "SansRole",
      "enabled": true, "emailVerified": true, "groups": [],
      "credentials": [{ "type": "password", "value": "dave", "temporary": false }]
    },
    {
      "username": "service-account-symphony-directory",
      "enabled": true,
      "serviceAccountClientId": "symphony-directory",
      "clientRoles": { "realm-management": ["query-groups", "view-users"] }
    }
  ],
  "clients": [
    {
      "clientId": "symphony-directory",
      "name": "Symphony (annuaire)",
      "description": "Compte de service : Symphony lit les groupes du realm (équipes)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__DIRECTORY_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "gitlab",
      "name": "GitLab",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__GITLAB_OIDC_SECRET__",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["__GITLAB_URL__/users/auth/openid_connect/callback"],
      "webOrigins": ["__GITLAB_URL__"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "symphony",
      "name": "Symphony",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["__SYMPHONY_URL__/auth/callback", "http://localhost:5173/auth/callback"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__SYMPHONY_URL__/##http://localhost:5173/"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups", "full.path": "false",
            "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience symphony",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "symphony",
            "id.token.claim": "false", "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
