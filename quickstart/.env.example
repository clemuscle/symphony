# Quickstart : copier en .env, puis remplir. Ce fichier contient un jeton :
# ne pas le commiter.

# gitlab (gitlab.com ou auto-hébergée) ou github
FORGE=gitlab

# Jeton de la forge
#   GitLab : jeton personnel ou de groupe, scope api
#   GitHub : jeton classique, scopes repo, workflow, delete_repo,
#            read:packages, write:packages, delete:packages
FORGE_TOKEN=

# GitLab seulement : l'instance et l'hôte de son registry d'images
FORGE_URL=https://gitlab.com
REGISTRY_HOST=registry.gitlab.com

# Groupe GitLab (ou organisation GitHub) des projets créés ; vide : le compte
# du jeton
FORGE_GROUP=

# Facultatif : repo des stacks de l'entreprise (un dossier par stack sous
# stacks/), proposées avec le catalogue officiel ; ex. mon-groupe/symphony-stacks
STACKS_REPO=

# Mot de passe de la base PostgreSQL (locale au quickstart)
DB_PASSWORD=change-moi

# SYMPHONY_VERSION=0.12
# SYMPHONY_PORT=8080
