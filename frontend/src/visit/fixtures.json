            "1.23"
          ],
          "default": "1.22",
          "locked": true
        },
        {
          "name": "log_level",
          "title": "Niveau de journalisation",
          "description": "Par défaut ; la variable LOG_LEVEL le change au déploiement",
          "type": "choice",
          "choices": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        },
        {
          "name": "metrics",
          "title": "Exposer les métriques Prometheus",
          "type": "boolean",
          "default": true
        },
        {
          "name": "metrics_path",
          "title": "Chemin des métriques",
          "type": "string",
          "default": "/metrics",
          "required": true,
          "when": {
            "metrics": true
          }
        },
        {
          "name": "helm_chart",
          "title": "Chart Helm dans le repo",
          "description": "Déployé tel quel sur Kubernetes (runtime argocd), et modifiable par l'équipe ; sinon Symphony génère les manifests",
          "type": "boolean",
          "default": false
        }
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "properties": {
                "metrics_path": false
              }
            },
            "if": {
              "properties": {
                "metrics": {
                  "const": true
                }
              },
              "required": [
                "metrics"
              ]
            },
            "then": {
              "required": [
                "metrics_path"
              ]
            }
          }
        ],
        "properties": {
          "go_version": {
            "const": "1.22",
            "default": "1.22",
            "description": "Fixée par l'équipe plateforme (images de build validées)",
            "enum": [
              "1.22",
              "1.23"
            ],
            "title": "Version de Go",
            "type": "string"
          },
          "helm_chart": {
            "default": false,
            "description": "Déployé tel quel sur Kubernetes (runtime argocd), et modifiable par l'équipe ; sinon Symphony génère les manifests",
            "title": "Chart Helm dans le repo",
            "type": "boolean"
          },
          "log_level": {
            "default": "info",
            "description": "Par défaut ; la variable LOG_LEVEL le change au déploiement",
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ],
            "title": "Niveau de journalisation",
            "type": "string"
          },
          "metrics": {
            "default": true,
            "title": "Exposer les métriques Prometheus",
            "type": "boolean"
          },
          "metrics_path": {
            "default": "/metrics",
            "minLength": 1,
            "title": "Chemin des métriques",
            "type": "string"
